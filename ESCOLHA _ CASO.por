programa
{
	funcao inicio()
	{			  
		inteiro op
		escreva("1-Listar 2-Gravar 3-Sair: ")
		leia(op)
		escolha(op)
		{

		caso 1:		//testa se o valor é igual a 1
		escreva ("Listar!")
		pare

		caso 2:		//testa se o valor é igual a 2
		escreva ("Gravar!")
		pare

		caso 2:		//testa se o valor é igual a 2
		escreva ("Saindo..")
		pare

		caso contrario:
		escreva ("Inválido!")
		}
	}
}
